{
  "name": "bloom-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "resolutions": {
    "happy-dom": "^21.0.4",
    "glob": "14.0.3",
    "**/glob/minimatch": "11.0.3",
    "**/eslint/minimatch": "11.0.3",
    "**/@eslint/config-array/minimatch": "11.0.3",
    "**/@typescript-eslint/typescript-estree/minimatch": "11.0.3",
    "**/test-exclude/minimatch": "11.0.3"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "NODE_OPTIONS='-r newrelic' next start",
    "https:proxy": "local-ssl-proxy --source 3010 --target 3000 --cert localhost.pem --key localhost-key.pem",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc -p tsconfig.json",
    "format": "prettier . --write",
    "test": "jest",
    "test:watch": "jest --watch",
    "cypress": "cypress open",
    "cypress:headless": "cypress run --headless true --browser chrome",
    "cypress:headless-spec": "cypress run --headless true --browser chrome --spec $SPEC",
    "cypress:coverage": "npx nyc report --reporter=text-summary",
    "cypress:auth": "cypress run --spec \"cypress/integration/auth/**/*.cy.tsx\"",
    "cypress:user-accounts": "cypress run --spec \"cypress/integration/user-accounts/**/*.cy.tsx\"",
    "cypress:admin": "cypress run --spec \"cypress/integration/admin/**/*.cy.tsx\"",
    "cypress:user-content": "cypress run --spec \"cypress/integration/user-content/**/*.cy.tsx\"",
    "cypress:partners": "cypress run --spec \"cypress/integration/partners/**/*.cy.tsx\"",
    "cypress:system": "cypress run --spec \"cypress/integration/system/**/*.cy.tsx\"",
    "cypress:public": "cypress run --spec \"cypress/integration/public/**/*.cy.tsx\"",
    "cypress:check-ungrouped": "node scripts/check-ungrouped-tests.js",
    "check:translations": "node ./scripts/checkTranslation.js",
    "check:links": "node ./scripts/checkLinks.mjs",
    "translate:storyblok": "node ./scripts/translateStoryblok.mjs",
    "fix:storyblok": "node ./scripts/fixStoryblokTranslations.mjs",
    "export:storyblok-lokalise": "node ./scripts/exportStoryblokToLokalise.mjs",
    "import:storyblok-lokalise": "node ./scripts/importStoryblokFromLokalise.mjs",
    "postinstall": "husky",
    "prepare": "husky",
    "knip": "knip"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@next/third-parties": "16.4.4",
    "@reduxjs/toolkit": "^2.13.0",
    "@rollbar/react": "^1.2.1",
    "@storyblok/react": "^7.4.0",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.21.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "firebase": "^13.1.0",
    "gemoji": "^8.1.0",
    "js-cookie": "^3.0.8",
    "minisearch": "7.2.0",
    "newrelic": "^14.10.0",
    "next": "16.4.4",
    "next-intl": "^4.14.9",
    "nextjs-hotjar": "^1.2.0",
    "phone": "^3.1.72",
    "react": "19.3.1",
    "react-cookie-consent": "^10.0.2",
    "react-dom": "19.3.1",
    "react-international-phone": "^4.8.0",
    "react-player": "^3.4.0",
    "react-redux": "^9.3.1",
    "rollbar": "^4.2.0",
    "socket.io-client": "^4.8.4",
    "storyblok-rich-text-react-renderer": "^3.0.1"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.1.3",
    "@next/bundle-analyzer": "16.4.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/newrelic": "^9.14.8",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "babel-plugin-istanbul": "^8.0.0",
    "cypress": "^16.2.1",
    "dotenv": "^18.0.9",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "mailslurp-client": "^17.6.0",
    "nyc": "^18.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
